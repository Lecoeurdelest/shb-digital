# .env.example — mẫu env SHB #132 (COMMIT file này; .env thật GITIGNORED, chứa key thật).
# Copy: cp .env.example .env  → điền key thật → server tự đọc (providers.reload() mỗi spawn).
#
# ── Chọn provider cho SDK runtime (D-45) ────────────────────────────────────
# SHB_PROVIDER = tên provider trong configs/providers.yaml. Bỏ trống = default (claude-cli).
#   claude-cli : subscription — dùng Claude CLI login máy (~/.claude). KHÔNG cần key.
#                Standalone KHÔNG có CLI login → KHÔNG chạy được, phải chọn zai.
#   zai        : keyed z.ai (GLM) — không phụ thuộc CLI auth (dùng cho demo standalone).
# SHB_PROVIDER=zai
# SHB_PROVIDERS_DISABLED = comma list provider ẨN khỏi picker (FIX C — deploy VM không có CLI auth
#   → tắt claude-cli tránh user chọn nhầm nút chết). Bỏ trống = đủ 3 nhà (dev). Compose prod set sẵn.
# SHB_PROVIDERS_DISABLED=claude-cli

# Key cho provider keyed (${tên_biến} trong providers.yaml). Chỉ điền cái đang dùng.
# zai=<z.ai api key>
# ANTHROPIC_API_KEY=<anthropic native key — nếu mở provider anthropic>

# ── DB (đã có ở CLAUDE.md §1; ghi lại cho standalone) ───────────────────────
# DATABASE_URL=postgresql://shb:shb@localhost:5432/shb
# Registry mặc định: configs/datastores.json. Chỉ đổi file khi deploy topology riêng
# (vd knowledge → vector DB); secret/DSN vẫn phải đi qua biến môi trường, không ghi vào JSON.
# SHB_DATASTORES_FILE=/absolute/path/to/datastores.json
# Pool là trên MỖI process; tổng connection = replicas × SHB_DB_POOL_MAX + job migration/ops.
SHB_DB_POOL_MIN=1
SHB_DB_POOL_MAX=10
# Fail-bounded: DB/DNS lỗi không được giữ worker vô hạn; pool đầy chờ ngắn thay vì fail ngẫu nhiên.
SHB_DB_CONNECT_TIMEOUT_SECONDS=5
SHB_DB_POOL_ACQUIRE_TIMEOUT_SECONDS=5
# Profile scale (Redis chỉ cache; Qdrant chỉ index vector dẫn xuất, không chứa ledger giao dịch).
# Dev: docker compose --profile scale up -d && dùng hai URL localhost dưới đây.
# Prod Compose: dùng hostname nội bộ redis/qdrant trong network shb132.
# REDIS_URL=redis://localhost:6379/0
# QDRANT_URL=http://localhost:6333
# Prompt active binding theo môi trường; DB lỗi sẽ fallback về file đã review trong repo.
SHB_PROMPT_ENV=default
SHB_PROMPT_CACHE_TTL_SECONDS=60

# ── Dev (bỏ auth để vào thẳng admin — D-39; KHÔNG bật ở prod) ────────────────
# DEV_SKIP_AUTH=1
# WRAP_API_KEY=<key wrapper psa.team — mở đường GPT models qua provider 'wrap'>

# ── Ranh runtime headless + SDK nhúng (S21 D-74) ─────────────────────────────
# `demo` giữ cấu hình local hiện tại. `bank_dc` fail-fast trước startup nếu còn secret/password
# demo, auth bypass, cookie không-secure hoặc provider không nằm trong allowlist nội bộ.
SHB_RUNTIME_MODE=demo
# Khác-origin mặc định đóng. Chỉ ghi exact origin http(s), phân tách bằng dấu phẩy; không wildcard/path.
SHB_CORS_ORIGINS=
# Bắt buộc và chỉ nhận exact hostname khi SHB_RUNTIME_MODE=bank_dc (không scheme/port/wildcard).
SHB_BANK_PROVIDER_HOSTS=
# bank_dc còn bắt buộc: JWT_SECRET >=32 ký tự, DATABASE_URL credential không-demo,
# COOKIE_SECURE=1, DEV_SKIP_AUTH=0 và toàn bộ SEED_*_PASSWORD >=12 ký tự không-demo.

# ── Intake hồ sơ server-to-server (D-77) ────────────────────────────────────
# Cấu hình nguồn không-secret mặc định là configs/case-intake.yaml; source trong file này mặc định tắt.
# Chỉ đổi path khi vận hành artifact cấu hình đã review/maker-checker.
# SHB_CASE_INTAKE_CONFIG=/absolute/path/to/case-intake.yaml
# Secret service credential chỉ nằm trong secret manager/.env thật; không điền vào YAML, log hoặc UI.
# SHB_LOS_CASE_INTAKE_API_KEY=
# Khi SHB_RUNTIME_MODE=bank_dc, API Gateway phải thực hiện mTLS/OIDC + scope case:ingest trước app;
# key này chỉ là lớp connector demo/test phía sau gateway, không thay thế service identity.

# ── Mail thông báo Gmail (T9-2 D-57) — THIẾU = no-op sạch (log + skip, không lỗi) ────
# Tạo App Password: Google Account → Security → 2-Step Verification (bật) → App passwords →
# chọn "Mail" → copy chuỗi 16 ký tự (bỏ khoảng trắng) vào SMTP_APP_PASSWORD.
# SMTP_USER=<email gmail người gửi, vd shbdigital@gmail.com>
# SMTP_APP_PASSWORD=<16 ký tự App Password — KHÔNG phải mật khẩu Gmail thường>
# NOTIFY_FROM_NAME=SHB Digital

# ── Chuông cửa webhook bàn phê duyệt (S19 D-71) — THIẾU URL = tắt sạch ─────────
# URL webhook chứa token bí mật: chỉ đặt trong .env gitignored, KHÔNG commit/log/chia sẻ qua chat.
# CẤM bật amount trên kênh ngoài bank DC; mặc định 0 chỉ gửi action + conv_id 8 ký tự + status + link.
SHB_NOTIFY_WEBHOOK_URL=
SHB_NOTIFY_CHANNEL=generic
SHB_NOTIFY_INCLUDE_AMOUNT=0

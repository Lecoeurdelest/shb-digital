{
  "theme": "base",
  "layout": "elk",
  "themeVariables": {
    "background": "#07111f",
    "primaryColor": "#10233b",
    "primaryTextColor": "#f8fafc",
    "primaryBorderColor": "#2dd4bf",
    "secondaryColor": "#172554",
    "tertiaryColor": "#111827",
    "lineColor": "#94a3b8",
    "textColor": "#e2e8f0",
    "fontFamily": "Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, Segoe UI, sans-serif",
    "fontSize": "13px"
  },
  "flowchart": {
    "curve": "basis",
    "htmlLabels": true,
    "nodeSpacing": 42,
    "rankSpacing": 64,
    "useMaxWidth": false
  },
  "er": {
    "diagramPadding": 24,
    "layoutDirection": "TB",
    "minEntityWidth": 120,
    "minEntityHeight": 80,
    "entityPadding": 16,
    "stroke": "#475569",
    "fill": "#0f172a",
    "fontSize": 12,
    "useMaxWidth": false
  }
}

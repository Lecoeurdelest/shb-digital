{
  "name": "@bank-digital/embed-sdk",
  "version": "0.1.0",
  "description": "Headless, React and Web Component SDK for BANK Digital conversations",
  "type": "module",
  "sideEffects": [
    "./dist/bank-digital-widget.iife.js"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./react": {
      "types": "./dist/types/react.d.ts",
      "import": "./dist/react.js",
      "require": "./dist/react.cjs"
    },
    "./element": {
      "types": "./dist/types/element.d.ts",
      "import": "./dist/element.js",
      "require": "./dist/element.cjs"
    },
    "./standalone.js": {
      "types": "./dist/types/standalone.d.ts",
      "default": "./dist/bank-digital-widget.iife.js"
    }
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED"
}
